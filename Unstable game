      metalness: 0.1
    });
    game.ice = new THREE.Mesh(iceGeo, iceMat);
    game.ice.rotation.x = -Math.PI / 2;
    game.ice.position.y = 0;
    game.ice.position.z = -15000; // Shift ice back so z=0 is center line, z=-30000 is far end
    scene.add(game.ice);

    // Puck
    const puckGeo = new THREE.CylinderGeometry(38, 38, 25, 32);
    const puckMat = new THREE.MeshStandardMaterial({ color: 0x111111, roughness: 0.8 });
    game.puck = new THREE.Mesh(puckGeo, puckMat);
    // Position puck near where the blade normally ends up, between the hash marks and slightly further away
    game.puck.position.set(95, 12.5, -20120);
    scene.add(game.puck);
    const ghostPuck = game.puck.clone();
    ghostPuck.material = game.puck.material.clone();
    ghostPuck.material.transparent = true;
    ghostPuck.material.opacity = 0.38;
    ghostPuck.material.depthWrite = false;
    ghostPuck.visible = false;
    scene.add(ghostPuck);


    // Projected Arrow
    function createArrowTexture() {
      const canvas = document.createElement('canvas');
      canvas.width = 512;
      canvas.height = 2048;
      const ctx = canvas.getContext('2d');

      // Gradient from white (bottom) to transparent (top)
      const grad = ctx.createLinearGradient(0, 2048, 0, 0);
      grad.addColorStop(0, 'rgba(56, 189, 248, 0.8)');
      grad.addColorStop(0.5, 'rgba(56, 189, 248, 0.4)');
      grad.addColorStop(1, 'rgba(56, 189, 248, 0)');
      ctx.fillStyle = grad;

      // Draw arrow shape
      ctx.beginPath();
      // Base
      ctx.moveTo(156, 2048);
      ctx.lineTo(356, 2048);
      // Shaft
      ctx.lineTo(356, 500);
      // Arrow head right
      ctx.lineTo(512, 500);
      // Arrow point
      ctx.lineTo(256, 0);
      // Arrow head left
      ctx.lineTo(0, 500);
      // Shaft
      ctx.lineTo(156, 500);
      ctx.closePath();
      ctx.fill();

      const tex = new THREE.CanvasTexture(canvas);
      tex.anisotropy = 16;
      return tex;
    }

    const arrowGeo = new THREE.PlaneGeometry(1500, 8000);
    const arrowMat = new THREE.MeshBasicMaterial({
      map: createArrowTexture(),
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
      side: THREE.DoubleSide
    });
    const projectedArrow = new THREE.Mesh(arrowGeo, arrowMat);
    projectedArrow.rotation.x = -Math.PI / 2;
    projectedArrow.position.set(0, 5, -22000);
    scene.add(projectedArrow);

    // --- SETUP BOARDING ---
    const boardGroup = new THREE.Group();

    // Load Logo Texture for Boards
    const textureLoader = new THREE.TextureLoader();
    const logoTex = textureLoader.load('./logo.png');
    logoTex.wrapS = THREE.RepeatWrapping;
    logoTex.wrapT = THREE.RepeatWrapping;
    // Flip texture horizontally to correct mirroring
    logoTex.repeat.set(-10, 1);

    const boardMat = new THREE.MeshStandardMaterial({ color: 0xffffff, map: logoTex, roughness: 0.2, side: THREE.DoubleSide });
    const kickPlateMat = new THREE.MeshStandardMaterial({ color: 0xfacc15, roughness: 0.5, side: THREE.DoubleSide }); // yellow
    const topRailMat = new THREE.MeshStandardMaterial({ color: 0x0033a0, roughness: 0.3 }); // blue
    const glassMat = new THREE.MeshPhysicalMaterial({ color: 0xffffff, transmission: 0.9, opacity: 1, transparent: true, roughness: 0.1, ior: 1.5, side: THREE.DoubleSide });

    const boardHeight = 1100;
    const glassHeight = 2000;
    const cornerRadius = 8500;

    // Rink geometry constants
    const straightWidth = rinkWidth - (2 * cornerRadius); // Width of far straight section
    const straightDepth = rinkDepth - cornerRadius; // Depth of side straight sections (assuming flat bottom at z=0 for now)

    // Far wall straight section
    const farWall = new THREE.Group();
    const farBoard = new THREE.Mesh(new THREE.PlaneGeometry(straightWidth, boardHeight), boardMat);
    farBoard.position.y = boardHeight/2;
    const farKick = new THREE.Mesh(new THREE.PlaneGeometry(straightWidth, 200), kickPlateMat);
    farKick.position.y = 100;
    farKick.position.z = 5;
    const farRail = new THREE.Mesh(new THREE.BoxGeometry(straightWidth, 50, 100), topRailMat);
    farRail.position.y = boardHeight;
    const farGlass = new THREE.Mesh(new THREE.PlaneGeometry(straightWidth, glassHeight), glassMat);
    farGlass.position.y = boardHeight + glassHeight/2;
    farWall.add(farBoard, farKick, farRail, farGlass);
    farWall.position.z = -rinkDepth;
    boardGroup.add(farWall);

    // Left wall straight section
    const leftWall = new THREE.Group();
    const sideWallGeo = new THREE.PlaneGeometry(straightDepth, boardHeight);
    const sideKickGeo = new THREE.PlaneGeometry(straightDepth, 200);
    const sideGlassGeo = new THREE.PlaneGeometry(straightDepth, glassHeight);
    const sideRailGeo = new THREE.BoxGeometry(straightDepth, 50, 100);

    const leftBoard = new THREE.Mesh(sideWallGeo, boardMat);
    leftBoard.position.y = boardHeight/2;
    const leftKick = new THREE.Mesh(sideKickGeo, kickPlateMat);
    leftKick.position.y = 100;
    leftKick.position.z = 5;
    const leftRail = new THREE.Mesh(sideRailGeo, topRailMat);
    leftRail.position.y = boardHeight;
    const leftGlass = new THREE.Mesh(sideGlassGeo, glassMat);
    leftGlass.position.y = boardHeight + glassHeight/2;
    leftWall.add(leftBoard, leftKick, leftRail, leftGlass);
    leftWall.rotation.y = Math.PI/2;
    leftWall.position.x = -rinkWidth/2;
    leftWall.position.z = -straightDepth/2;
    boardGroup.add(leftWall);

    // Right wall straight section
    const rightWall = new THREE.Group();
    const rightBoard = new THREE.Mesh(sideWallGeo, boardMat);
    rightBoard.position.y = boardHeight/2;
    const rightKick = new THREE.Mesh(sideKickGeo, kickPlateMat);
    rightKick.position.y = 100;
    rightKick.position.z = -5; // Point towards center
    const rightRail = new THREE.Mesh(sideRailGeo, topRailMat);
    rightRail.position.y = boardHeight;
    const rightGlass = new THREE.Mesh(sideGlassGeo, glassMat);
    rightGlass.position.y = boardHeight + glassHeight/2;
    rightWall.add(rightBoard, rightKick, rightRail, rightGlass);
    rightWall.rotation.y = -Math.PI/2;
    rightWall.position.x = rinkWidth/2;
    rightWall.position.z = -straightDepth/2;
    boardGroup.add(rightWall);

    // Corners
    // Top Left Corner (Far Left)
    const cornerGeo = new THREE.CylinderGeometry(cornerRadius, cornerRadius, boardHeight, 32, 1, true, Math.PI, Math.PI/2);
    const cornerKickGeo = new THREE.CylinderGeometry(cornerRadius - 5, cornerRadius - 5, 200, 32, 1, true, Math.PI, Math.PI/2);
    const cornerGlassGeo = new THREE.CylinderGeometry(cornerRadius, cornerRadius, glassHeight, 32, 1, true, Math.PI, Math.PI/2);
    // Rail uses Torus for curved edge
    const cornerRailGeo = new THREE.TorusGeometry(cornerRadius, 25, 8, 32, Math.PI/2);

    const tlCorner = new THREE.Group();
    const tlBoard = new THREE.Mesh(cornerGeo, boardMat);
    tlBoard.position.y = boardHeight/2;
    const tlKick = new THREE.Mesh(cornerKickGeo, kickPlateMat);
    tlKick.position.y = 100;
    const tlGlass = new THREE.Mesh(cornerGlassGeo, glassMat);
    tlGlass.position.y = boardHeight + glassHeight/2;
    const tlRail = new THREE.Mesh(cornerRailGeo, topRailMat);
    tlRail.rotation.x = -Math.PI/2;
    tlRail.rotation.z = Math.PI;
    tlRail.position.y = boardHeight;

    tlCorner.add(tlBoard, tlKick, tlGlass, tlRail);
    tlCorner.position.x = -rinkWidth/2 + cornerRadius;
    tlCorner.position.z = -rinkDepth + cornerRadius;
    boardGroup.add(tlCorner);

    // Top Right Corner (Far Right)
    const trCornerGeo = new THREE.CylinderGeometry(cornerRadius, cornerRadius, boardHeight, 32, 1, true, Math.PI/2, Math.PI/2);
    const trCornerKickGeo = new THREE.CylinderGeometry(cornerRadius - 5, cornerRadius - 5, 200, 32, 1, true, Math.PI/2, Math.PI/2);
    const trCornerGlassGeo = new THREE.CylinderGeometry(cornerRadius, cornerRadius, glassHeight, 32, 1, true, Math.PI/2, Math.PI/2);

    const trCorner = new THREE.Group();
    const trBoard = new THREE.Mesh(trCornerGeo, boardMat);
    trBoard.position.y = boardHeight/2;
    const trKick = new THREE.Mesh(trCornerKickGeo, kickPlateMat);
