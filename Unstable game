        });
        document.getElementById('btnPhysicsSettings').addEventListener('click', () => {
          appState.mode = 'settings';
          updateUiMode();
        });
        document.getElementById('btnGameSettingsBack').addEventListener('click', () => {
          appState.mode = 'menu';
          updateUiMode();
        });
        document.getElementById('btnMenu').addEventListener('click', () => {
          appState.mode = 'menu';
          updateUiMode();
        });
        document.getElementById('btnSettingsBack').addEventListener('click', (e) => {
          e.stopPropagation(); // Prevent panel collapse
